rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Admin = role 'admin' on the user's Firestore users/{uid} document, the
    // same check firestore.rules uses (no email address stored here).
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /places/{uid}/{fileName} {
      allow read: if true;

      // Only into your own folder, only images, and at most 10 MB each.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if isAdmin();
    }
  }
}
