{
  "expo": {
    "name": "GoOutside",
    "slug": "GoOutside",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "scheme": "gooutside",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B4A2E",
        "foregroundImage": "./assets/logo/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B4A2E",
          "image": "./assets/logo/adaptive-icon-foreground.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GoOutside uses your camera to let you take a photo of the place you're posting."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoOutside uses your location to center the map when you post a place."
        }
      ],
      "react-native-maps",
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
