rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {

      allow read: if isOwner(uid);

      // New accounts (signup, and the sign-in backfill for pre-existing
      // accounts) always start as a plain 'user' — only an existing admin
      // can promote someone via `update`, never the owner themselves.
      allow create: if isOwner(uid) && request.resource.data.role == 'user';

      allow update: if isAdmin()
        || (isOwner(uid) && request.resource.data.role == resource.data.role);
    }

    match /places/{placeId} {

      allow read: if resource.data.status == 'approved'
        || isOwner(resource.data.submittedBy)
        || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (
          isOwner(resource.data.submittedBy)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notified'])
          && resource.data.notified == false
          && request.resource.data.notified == true
        );

      allow delete: if isAdmin();
    }

    match /curatedAttractions/{attractionId} {

      // Admin-curated content (not user submissions): anyone can read, only
      // the admin can write.
      allow read: if true;

      allow write: if isAdmin();
    }
  }
}
